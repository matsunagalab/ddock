# Byte-compiled / optimized / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Training / research artifacts
*.ckpt
*.pt
*.pth
runs/
outputs/
checkpoints/
wandb/
lightning_logs/

# Large generated / downloaded research data (reproducible via scripts/)
data/
external/
logs/
*.h5

# Literature PDFs (publisher copies — not redistributable)
ref/

# LaTeX intermediates (the PDF itself is committed so it can be read
# without a TeX installation; regenerate with `tectonic docs/theory_ja.tex`)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
